# ==============================================================================
# NEXUS - Production & Development Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND CONFIGURATION (Vercel / Local)
# ------------------------------------------------------------------------------
# Production: https://api.lunor.co.in
# Local: http://localhost:8000/api/v1 (or leave blank to use Next.js rewrite proxy)
NEXT_PUBLIC_API_URL=https://api.lunor.co.in

# ------------------------------------------------------------------------------
# 2. BACKEND CONFIGURATION (Render / Local)
# ------------------------------------------------------------------------------
APP_NAME=NEXUS
# Set to 'production' for live deployments, 'development' for local
APP_ENV=production
DEBUG=False
API_V1_STR=/api/v1

# Security & JWT Token Signing
# Generate a secure 32+ character random string in production
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Managed Database Connection String (PostgreSQL)
# Format: postgresql://username:password@hostname:5432/databasename
# In local environments without PostgreSQL, defaults to: sqlite:///./nexus.db
DATABASE_URL=

# CORS Allowed Origins (Comma-separated)
# In production, specify the exact frontend domain(s)
CORS_ORIGINS=https://lunor.co.in,https://www.lunor.co.in,http://localhost:3000,http://127.0.0.1:3000

# Organization Intelligence Defaults
DEFAULT_UNDERUTILIZATION_THRESHOLD=40.0
DEFAULT_OVERUTILIZATION_THRESHOLD=90.0
DEFAULT_CRITICAL_UTILIZATION_THRESHOLD=95.0
DEFAULT_ENERGY_COST_PER_UNIT=8.50
MINIMUM_FORECAST_DAYS=14

# Optional: External AI Explainer Key (leave empty to use deterministic explainer)
OPENAI_API_KEY=
